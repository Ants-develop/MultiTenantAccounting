# Frontend env (Vite loads env files from the Vite root)
# Vite root for this repo is the `client/` folder (see vite.config.ts).

# Supabase (Practice Management UI)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Use either name (the code supports both)
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
